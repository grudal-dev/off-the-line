# Copie ce fichier en .env et remplis les valeurs
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/strava/callback/

# Fond de carte CARTO, clé gratuite : https://carto.com/basemaps/apikey
# (sans clé, la carte utilise un fond Esri sans clé)
CARTO_API_KEY=
