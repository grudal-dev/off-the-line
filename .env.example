# Copie ce fichier en .env et remplis les valeurs
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/strava/callback/

# Fond de carte CARTO, clé gratuite : https://carto.com/basemaps/apikey
# (sans clé, la carte utilise un fond Esri sans clé)
CARTO_API_KEY=

# Fonds de carte vectoriels (facultatif : OpenFreeMap par défaut)
# VECTOR_TILES_URL=pmtiles://https://ton-stockage.example/planet.pmtiles
# VECTOR_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
# DEM_TILES_URL=https://elevation-tiles-prod.s3.amazonaws.com/terrarium/{z}/{x}/{y}.png
